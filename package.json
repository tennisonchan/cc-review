{
  "name": "cc-review",
  "version": "0.3.0",
  "description": "Codex plugin for running read-only Claude Code reviews and review gates.",
  "type": "module",
  "private": false,
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18.18.0"
  },
  "bin": {
    "cc-review-companion": "./plugins/cc-review/scripts/cc-review-companion.mjs",
    "cc-review": "./plugins/cc-review/scripts/bin/cc-review.mjs",
    "cc-review-setup": "./plugins/cc-review/scripts/bin/cc-review-setup.mjs",
    "cc-review-status": "./plugins/cc-review/scripts/bin/cc-review-status.mjs",
    "cc-review-result": "./plugins/cc-review/scripts/bin/cc-review-result.mjs",
    "cc-review-cancel": "./plugins/cc-review/scripts/bin/cc-review-cancel.mjs",
    "cc-adversarial-review": "./plugins/cc-review/scripts/bin/cc-adversarial-review.mjs"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "validate": "node --test tests/*.test.mjs && node plugins/cc-review/scripts/cc-review-companion.mjs setup --json"
  },
  "keywords": [
    "codex",
    "claude",
    "code-review",
    "plugin"
  ],
  "author": "Tennison Chan"
}
