{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision", "approved", "max_severity", "needs_changes", "notes"],
  "properties": {
    "decision": {
      "type": "string",
      "enum": ["approved", "needs_changes"]
    },
    "approved": {
      "type": "boolean"
    },
    "max_severity": {
      "$ref": "#/$defs/severity"
    },
    "needs_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "category", "location", "summary", "required_action"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "$ref": "#/$defs/severity"
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "type": "string"
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "required_action": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "severity": {
      "type": "string",
      "enum": ["info", "low", "medium", "high"]
    }
  }
}
