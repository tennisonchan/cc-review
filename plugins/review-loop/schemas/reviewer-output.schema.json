{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "review_status",
    "subject_reviewable",
    "substantive_merit_evaluated",
    "acknowledged_packet_digest",
    "acknowledged_material_digests",
    "decision",
    "summary",
    "findings",
    "required_next_actions",
    "limitations"
  ],
  "properties": {
    "review_status": {
      "type": "string",
      "enum": ["performed", "partial", "not_performed"]
    },
    "subject_reviewable": { "type": "boolean" },
    "substantive_merit_evaluated": { "type": "boolean" },
    "acknowledged_packet_digest": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$"
    },
    "acknowledged_material_digests": {
      "type": "array",
      "items": { "$ref": "#/$defs/sha256" }
    },
    "decision": {
      "type": "string",
      "enum": ["approved", "changes_requested", "invalid_input", "blocked"]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "category", "message", "locations", "required_action", "reviewer_disposition"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "$ref": "#/$defs/severity"
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "locations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "required_action": {
            "type": "string",
            "minLength": 1,
            "description": "The concrete remediation for a blocking finding; a recommendation when reviewer_disposition is advisory."
          },
          "reviewer_disposition": {
            "type": "string",
            "enum": ["blocking", "advisory"]
          }
        }
      }
    },
    "required_next_actions": {
      "type": "array",
      "description": "Actions interpreted with the explicit decision: advisory follow-up when approved, or required remediation before advancement when non-approving.",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "severity": {
      "type": "string",
      "enum": ["info", "low", "medium", "high"]
    }
  }
}
